# Installed on the STAGING server as /etc/systemd/system/projection-sync.timer.
#
# Daily, before the ESPN player pool syncs at 07:45 UTC, so the two sides of the id match are
# never more than a few hours out of step with each other. Persistent catches up a run missed
# while the box was down — a skipped day would otherwise leave the store silently stale until
# somebody noticed a wrong rookie marker.
[Unit]
Description=Run the SlapStat projection ingestion daily

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
