# The forced-command scripts run on the Linux servers. A CRLF working copy on Windows would
# break the shebang ("bad interpreter: /usr/bin/env bash^M") when copied across, so pin them
# to LF regardless of core.autocrlf.
*.sh text eol=lf
*.conf text eol=lf

# systemd units are copied to the servers the same way and read the same way; a CR at the
# end of an ExecStart path is part of the path as far as systemd is concerned.
*.service text eol=lf
*.timer text eol=lf

# Brand assets: no line-ending conversion.
*.png binary
*.ico binary
